<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Dreamine.Gem</AssemblyName><RootNamespace>Dreamine.Gem</RootNamespace>
    <PackageId>Dreamine.Gem</PackageId><Version>1.0.1</Version><Authors>Dreamine Core Team</Authors><Company>Dreamine</Company>
    <Description>Dreamine GEM runtime with typed equipment profiles and an E30-0611 derived interoperability subset.</Description>
    <PackageReleaseNotes>1.0.1: makes the QuickStart package-first, improves NuGet onboarding, adds standalone repository builds, CI and SonarQube Cloud analysis, and portable symbols with Source Link metadata.</PackageReleaseNotes>
    <PackageTags>dreamine;gem;secs;runtime;equipment</PackageTags><PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem</RepositoryUrl><Title>Dreamine.Gem</Title>
    <Copyright>© 2026 Dreamine Core Team. All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild><GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="\" /><None Include="icon.png" Pack="true" PackagePath="\" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
    <EmbeddedResource Remove="samples\**\*" />
    <None Remove="samples\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj')" />
    <ProjectReference Include="..\Secs.Abstractions\Dreamine.Secs.Abstractions.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Secs.Abstractions\Dreamine.Secs.Abstractions.csproj')" />
    <ProjectReference Include="..\Secs.Com\Dreamine.Secs.Com.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Secs.Com\Dreamine.Secs.Com.csproj')" />
    <PackageReference Include="Dreamine.Gem.Abstractions" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj')" />
    <PackageReference Include="Dreamine.Secs.Abstractions" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Secs.Abstractions\Dreamine.Secs.Abstractions.csproj')" />
    <PackageReference Include="Dreamine.Secs.Com" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Secs.Com\Dreamine.Secs.Com.csproj')" />
  </ItemGroup>
</Project>
